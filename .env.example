# Live AI recipe suggestions (OpenAI).
# Copy to .env.local and paste your key:
#   cp .env.example .env.local
#
# Get a key: https://platform.openai.com/api-keys
# Without a key the app still works with demo (mock) recipes.
OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
